<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.maclocalapi.start</string>
    
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/afm</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- If the script crashes fast (e.g. nvm missing), don't spin. -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/tmp/com.maclocalapi.start.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/com.maclocalapi.start.err.log</string>
</dict>
</plist>